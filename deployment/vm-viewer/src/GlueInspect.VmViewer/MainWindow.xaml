<Window x:Class="GlueInspect.VmViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GlueInspect.VmViewer.Controls"
        Title="涂胶在线检测 · VM 结果查看器"
        Width="1640" Height="980" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- 顶部标题与图片目录 -->
        <Border Grid.Row="0" Background="#10161E" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="12" Background="#173847" BorderBrush="#2E7894" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="VM" FontSize="17" FontWeight="Bold" Foreground="#75DDF7"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,12,24,10">
                    <DockPanel>
                        <TextBlock Text="涂胶在线检测" Style="{StaticResource Title}" />
                        <TextBlock Text="  VM 结果查看器" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding ImageCount, StringFormat=目录文件 {0} 个}" Style="{StaticResource Hint}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Folder, UpdateSourceTrigger=LostFocus}" Style="{StaticResource PathBox}"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="选择目录" Margin="8,0,0,0" Style="{StaticResource ToolButton}"
                                Command="{Binding BrowseFolderCommand}" />
                        <Button Grid.Column="2" Content="刷新" Margin="8,0,0,0" Style="{StaticResource ToolButton}"
                                Command="{Binding RefreshCommand}" />
                        <Button Grid.Column="3" Content="打开文件夹" Margin="8,0,0,0" Style="{StaticResource ToolButton}"
                                Command="{Binding OpenFolderCommand}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="{Binding TcpBrush}" CornerRadius="14" Padding="12,6" MinWidth="178">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="White" Opacity="0.9" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding TcpState}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Endpoint, StringFormat=TCP · {0}}" Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 两张结果图 + 右侧结论 -->
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,0,12,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="原始图像" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="VM 图像源未经叠加的原始画面" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="适应窗口" Style="{StaticResource ToolButton}"
                                Padding="10,5" VerticalAlignment="Center" Click="FitOriginal_Click" />
                    </DockPanel>
                    <Border Grid.Row="1" Margin="10,0" Background="#080C11" CornerRadius="8" ClipToBounds="True">
                        <controls:ImageViewer x:Name="OriginalViewer" Source="{Binding OriginalImage}" />
                    </Border>
                    <DockPanel Grid.Row="2" Margin="16,0">
                        <TextBlock Text="滚轮缩放 · 拖动平移 · 右键双击适应" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding OriginalName}" Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="52" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="34" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,0,12,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="卡尺检测结果" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="边缘对模型、左右边缘和缺陷框" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="适应窗口" Style="{StaticResource ToolButton}"
                                Padding="10,5" VerticalAlignment="Center" Click="FitCaliper_Click" />
                    </DockPanel>
                    <Border Grid.Row="1" Margin="10,0" Background="#080C11" CornerRadius="8" ClipToBounds="True">
                        <controls:ImageViewer x:Name="CaliperViewer" Source="{Binding CaliperImage}" />
                    </Border>
                    <DockPanel Grid.Row="2" Margin="16,0">
                        <TextBlock Text="滚轮缩放 · 拖动平移 · 右键双击适应" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CaliperName}" Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{Binding VerdictBrush}" CornerRadius="14" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="检测结论" Foreground="#D9FFFFFF" FontSize="13" />
                        <TextBlock Text="{Binding VerdictText}" Foreground="White" FontSize="54" FontWeight="Bold" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding VerdictSubText}" Foreground="#E5FFFFFF" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="通信" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TcpState}" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="最近更新" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastUpdate}" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="原图编号" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OriginalName}" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="卡尺编号" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CaliperName}" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Text="历史记录" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{StaticResource TextBrush}"
                                   FontSize="12" VerticalAlignment="Center">
                            <Run Text="已保存 " />
                            <Run Text="{Binding HistoryCount, Mode=OneWay}" Foreground="#75DDF7" FontWeight="SemiBold" />
                            <Run Text=" 条" />
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="4,0,0,8">
                            <StackPanel>
                                <TextBlock Text="历史数据" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="点击记录可回看当时的图片和结论" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="返回实时" Padding="10,5"
                                    Command="{Binding ReturnLiveCommand}" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHistoryMode}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DockPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding HistoryRecords}"
                                 SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#203342" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111920" BorderBrush="#263341" BorderThickness="1"
                                            CornerRadius="7" Padding="10,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SequenceText}" FontSize="13" FontWeight="SemiBold" Foreground="#E8EDF4" />
                                                <TextBlock Text="{Binding TimeText}" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding ImageSequenceText}" Style="{StaticResource Hint}" Margin="0,1,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="18" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#EF4459" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Verdict}" Value="OK">
                                                                <Setter Property="Foreground" Value="#2EC48C" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="4,8,4,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="刷新" Padding="10,5" Style="{StaticResource ToolButton}"
                                        Command="{Binding RefreshHistoryCommand}" />
                                <Button Content="打开历史目录" Margin="7,0,0,0" Padding="10,5" Style="{StaticResource ToolButton}"
                                        Command="{Binding OpenHistoryFolderCommand}" />
                                <Button Content="清除历史" Margin="7,0,0,0" Padding="10,5"
                                        Background="#351A20" BorderBrush="#7A303C" Foreground="#FFB7C0"
                                        Style="{StaticResource ToolButton}"
                                        Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#080C11" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,0">
                <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <TextBlock Text="数据来源：VisionMaster  ·  前端不执行检测算法" Style="{StaticResource Hint}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
