[Unit]
Description=Glue inspection agent (headless)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/glue
ExecStart=/opt/glue/bin/glue-agent --config /opt/glue/configs/default.yaml --input /opt/glue/samples --state /opt/glue/logs/results.jsonl --watch 5
Restart=always
RestartSec=3
User=glue
Group=glue

[Install]
WantedBy=multi-user.target
