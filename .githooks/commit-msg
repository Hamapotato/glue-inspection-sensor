#!/bin/sh
# 提交信息检查：英文祈使句、首字母大写、ASCII、首行 ≤72 字符。
# 允许 Merge / Revert / fixup! / squash! 等自动消息。
set -u

msg_file=$1
subject=$(head -n 1 "$msg_file" | tr -d '\r')

[ -z "$subject" ] && exit 0
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*|"Merge "*|"Revert "*)
    exit 0;;
esac

len=$(printf '%s' "$subject" | wc -c | tr -d ' ')
if [ "$len" -gt 72 ]; then
  echo "[commit-msg] 首行超过 72 字符（当前 $len）" >&2
  echo "             $subject" >&2
  exit 1
fi

first=$(printf '%s' "$subject" | cut -c1)
case "$first" in
  [A-Z]) ;;
  *)
    echo "[commit-msg] 首行必须以大写英文字母开头（祈使句）" >&2
    echo "             $subject" >&2
    exit 1;;
esac

if printf '%s' "$subject" | LC_ALL=C grep -q '[^ -~]'; then
  echo "[commit-msg] 提交信息必须为 ASCII（中文请写在正文或文档里）" >&2
  echo "             $subject" >&2
  exit 1
fi

case "$subject" in
  *.) echo "[commit-msg] 首行结尾不要加句号" >&2; exit 1;;
esac

exit 0
